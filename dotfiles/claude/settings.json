{
  "permissions": {
    "defaultMode": "acceptEdits"
  },
  "model": "opus",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/siddharthks/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash '/Users/siddharthks/.claude/hooks/memory-to-inbox.sh'",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "bash /Users/siddharthks/.claude/statusline-command.sh",
    "refreshInterval": 60
  },
  "enabledPlugins": {
    "exa@claude-plugins-official": true,
    "engineering@synced": false,
    "cc-plugin-you-should-know@builtin": true
  },
  "extraKnownMarketplaces": {},
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "xhigh"
    },
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "dialogExpiry": "never",
  "pluginConfigs": {
    "agents-md@builtin": {
      "options": {
        "instructionFiles": "claude-md-and-agents-md"
      }
    }
  },
  "theme": "auto",
  "editorMode": "normal",
  "verbose": false,
  "preferredNotifChannel": "auto",
  "autoCompactEnabled": true,
  "switchModelsOnFlag": true,
  "autoContinueAtUsageLimit": true,
  "teammateMode": "auto",
  "remoteControlAtStartup": true,
  "crossSessionInbound": "accept",
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "useAutoModeDuringPlan": true
}

{
    "editor.inlineSuggest.enabled": true,
    "editor.autoClosingBrackets": "always",
    "[python]": {
        "editor.defaultFormatter": "ms-python.python",
        "editor.formatOnType": true,
    },
    "[markdown]": {
        "editor.tabSize": 4,
        "editor.formatOnSave": false,
    },
    "[json]": {
        "editor.quickSuggestions": {
            "strings": true,
        },
        "editor.suggest.insertMode": "replace",
        "editor.tabSize": 2,
        "editor.defaultFormatter": "vscode.json-language-features",
    },
    "[yaml]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 4,
    },

    "[typescript]": {
        "editor.defaultFormatter": "esbenp.prettier-vscode",
        "editor.formatOnType": true,
        "prettier.semi": false,
        "editor.tabSize": 2,
    },

    "explorer.confirmDragAndDrop": false,
    "git.enableSmartCommit": true,
    "[solidity]": {
        "editor.indentSize": 4,
        "editor.defaultFormatter": "JuanBlanco.solidity",
        "editor.tabSize": 4,
    },
    "editor.formatOnSaveMode": "file",
    "go.toolsManagement.autoUpdate": true,
    "editor.minimap.enabled": false,
    "update.showReleaseNotes": false,
    "solidity.packageDefaultDependenciesContractsDirectory": "src",
    "solidity.packageDefaultDependenciesDirectory": "lib",
    "editor.accessibilitySupport": "off",
    "security.workspace.trust.untrustedFiles": "open",
    "prettier.tabWidth": 4,
    "terminal.integrated.cursorStyle": "line",
    "terminal.integrated.cursorBlinking": true,
    "terminal.integrated.fontSize": 16,
    "terminal.integrated.lineHeight": 1.2,
    "terminal.integrated.fontFamily": "'JetBrains Mono', 'Google Sans Code', Menlo, Monaco, 'Courier New', monospace",
    "excalidraw.theme": "auto",
    "diffEditor.codeLens": true,
    "github.copilot.nextEditSuggestions.enabled": true,
    "geminicodeassist.inlineSuggestions.enableAuto": false,
    "git.replaceTagsWhenPull": true,
    "markdown.preview.fontFamily": "'JetBrains Mono', 'Google Sans Code', -apple-system, BlinkMacSystemFont, Menlo, 'Roboto Mono','Segoe WPC', 'Segoe UI', system-ui, 'Ubuntu', 'Droid Sans', sans-serif",
    "markdown.preview.fontSize": 16,
    "markdown.preview.breaks": true,
    "editor.fontFamily": "'JetBrains Mono', 'Google Sans Code', Menlo, Monaco, 'Courier New', monospace",
    "editor.fontSize": 16,
    // Let VS Code choose its recommended line height for this font size.
    "editor.lineHeight": 0,
    "github.copilot.enable": {
        "*": false,
        "plaintext": false,
        "markdown": false,
        "scminput": false,
    },
    "[dockercompose]": {
        "editor.insertSpaces": true,
        "editor.tabSize": 2,
        "editor.autoIndent": "advanced",
        "editor.quickSuggestions": {
            "other": true,
            "comments": false,
            "strings": true,
        },
        "editor.defaultFormatter": "redhat.vscode-yaml",
    },
    "[github-actions-workflow]": {
        "editor.defaultFormatter": "redhat.vscode-yaml",
    },

    "window.commandCenter": true,
    "update.releaseTrack": "prerelease",
    "explorer.confirmDelete": false,
    // "terminal.integrated.suggest.enabled": true,
    // "terminal.integrated.cursorBlinking": true,
    // "terminal.integrated.cursorStyle": "line",
    // "terminal.integrated.cursorStyleInactive": "line",
    "terminal.integrated.sendKeybindingsToShell": true,
    "editor.formatOnSave": true,
    "editor.formatOnType": false,
    "editor.wordWrap": "on",
    "window.autoDetectColorScheme": true,
    "workbench.preferredLightColorTheme": "Light 2026",
    "workbench.preferredDarkColorTheme": "Dark 2026",
    // Nested agent checkouts are separate projects, including .claude/worktrees/.
    // Open a worktree directly when needed; do not scan it from its parent repo.
    "files.watcherExclude": {
        "**/worktrees/**": true,
        "**/.worktrees/**": true,
        "**/target/**": true,
    },
    "files.exclude": {
        "**/worktrees": true,
        "**/.worktrees": true,
    },
    "git.repositoryScanIgnoredFolders": ["node_modules", "worktrees", ".worktrees"],
    "git.confirmSync": false,
    "git.autofetch": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode",
    "[rust]": {
        "editor.defaultFormatter": "rust-lang.rust-analyzer",
    },
    "[go]": {
        "editor.defaultFormatter": "golang.go",
    },
    "gitlens.ai.gitkraken.model": "gemini:gemini-2.0-flash",
    "gitlens.launchpad.indicator.enabled": false,
    "cursor.cpp.disabledLanguages": [],
    "claudeCode.selectedModel": "default",
    "claudeCode.preferredLocation": "panel",
    "claudeCode.useCtrlEnterToSend": true,
    // "rust-analyzer.checkOnSave": false,
    // "rust-analyzer.cargo.buildScripts.rebuildOnSave": false,
    // "rust-analyzer.procMacro.enable": true,
    // "rust-analyzer.procMacro.attributes.enable": true,
    "makefile.configureOnOpen": true,
    "diffEditor.ignoreTrimWhitespace": false,
    "diffEditor.hideUnchangedRegions.enabled": true,
    "workbench.editor.wrapTabs": true,
    "git.openRepositoryInParentFolders": "never",
    "security.promptForLocalFileProtocolHandling": false,
    "redhat.telemetry.enabled": false,
    "githubPullRequests.pullBranch": "never",
    "chat.disableAIFeatures": true,
    "yaml.disableSchemaDetection": [
        "**/.github/workflows/*.yml",
        "**/.github/workflows/*.yaml",
        "**/.gitea/workflows/*.yml",
        "**/.gitea/workflows/*.yaml",
        "**/.forgejo/workflows/*.yml",
        "**/.forgejo/workflows/*.yaml",
    ],
    "js/ts.experimental.useTsgo": true,
    "workbench.activityBar.location": "top",
    // "gitlens.launchpad.indicator.enabled": false
}
